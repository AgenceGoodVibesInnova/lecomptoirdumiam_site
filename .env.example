# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Clé « publishable » (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé « secret » (sb_secret_…), uniquement côté serveur (jamais dans le navigateur)
SUPABASE_SERVICE_ROLE_KEY=

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=https://lecomptoirdumiam.fr

# Connexion Google / Facebook : mettre 1 une fois le fournisseur activé dans Supabase
NEXT_PUBLIC_AUTH_GOOGLE=
NEXT_PUBLIC_AUTH_FACEBOOK=

# SumUp (developer.sumup.com) : clé API secrète et code marchand
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=

# Resend (resend.com) pour l'e-mail de bienvenue
RESEND_API_KEY=
EMAIL_FROM="Le Comptoir du Miam <bonjour@lecomptoirdumiam.fr>"
